# 复制为 .env 后填写。安装脚本会自动生成，通常无需手改。
# Windows 下不用此文件，改由管理脚本写入用户级环境变量。

IMAGE=ghcr.io/PMJ520/ai-baoxiao-reimburse-bot:latest
DATA_DIR=./data
HOST_PORT=8000
TZ=Asia/Shanghai

# 访问凭据（安装时随机生成）
API_TOKEN=
ADMIN_USER=admin
ADMIN_PASSWORD=

# 对话模型：claude 或 openai（通义/DeepSeek/智谱等兼容 OpenAI 协议的都填 openai）
LLM_PROVIDER=claude
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 飞书自建应用凭据
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 仅 Caddy DNS 模式需要（域名在公网、服务在内网时签真证书）
DNS_PROVIDER=
DNS_API_TOKEN=
